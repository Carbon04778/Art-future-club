{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "premium_portfolio",
        "featured_listing",
        "gallery_partnership"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled",
        "expired"
      ],
      "default": "active"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "plan",
    "status"
  ]
}