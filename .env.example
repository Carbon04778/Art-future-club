# Supabase (Phase 2)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Media host (Phase 3 — Cloudflare R2 public bucket base URL)
VITE_MEDIA_BASE_URL=

# NEVER put the Supabase service-role key in a VITE_ variable.
# Anything prefixed VITE_ is compiled into the public JS bundle.
